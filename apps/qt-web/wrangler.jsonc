{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "quick-translator-web",
  "compatibility_date": "2026-07-31",
  "workers_dev": false,
  "routes": [
    { "pattern": "dich.vn-converter.org", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
