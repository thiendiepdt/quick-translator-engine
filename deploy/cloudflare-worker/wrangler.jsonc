{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "quick-translator-gateway",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-22",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    // Replace this after `sam deploy`; the URL itself is not a secret.
    "LAMBDA_FUNCTION_URL": "https://replace-me.lambda-url.ap-southeast-1.on.aws/",
    "AWS_REGION": "ap-southeast-1",
    // Comma-separated exact browser origins. Replace/add the deployed qt-web origin.
    "CORS_ALLOWED_ORIGINS": "http://localhost:5173"
  },
  "secrets": {
    "required": ["AWS_ACCESS_KEY_ID", "AWS_SECRET_ACCESS_KEY"]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 0.1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
